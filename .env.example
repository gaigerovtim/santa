# Скопируйте в .env и поменяйте нужное. Для локального запуска через docker compose
# файл .env не обязателен: в docker-compose.yml заданы значения по умолчанию.
# Адреса сервисов внутри Docker (postgres, redis, s3, mailpit) задаёт docker-compose.yml.

# --- Основное ---
# Публичный адрес сайта: из него строятся ссылки в письмах и адрес возврата после оплаты.
APP_URL=http://localhost:3000
# База PostgreSQL. Нужна только при запуске без Docker (npm run dev).
DATABASE_URL=postgresql://santa:santa@localhost:5432/santa
# Redis для очередей BullMQ.
REDIS_URL=redis://localhost:6379

# --- Хранилище файлов (S3) ---
# Адрес S3 для сервера. Локально — RustFS из docker compose, в продакшене — https://storage.yandexcloud.net
S3_ENDPOINT=http://localhost:9000
# Адрес S3, который видит браузер (для presigned-ссылок). Если пусто — равен S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=dedmoroz
S3_ACCESS_KEY=santa-dev
S3_SECRET_KEY=santa-dev-secret

# --- Почта ---
# SMTP-сервер. Локально — Mailpit (письма видны на http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Дед Мороз <video@example.ru>"

# --- Админка и безопасность ---
# Пароль входа в /admin. В продакшене — длинный случайный.
ADMIN_PASSWORD=admin
# Ключ подписи cookie-сессии админки, не короче 32 символов.
SESSION_SECRET=dev-session-secret-change-me-0123456789
# Соль для хеширования IP (лимиты без хранения самих адресов).
IP_HASH_SALT=dev-ip-salt

# --- Провайдеры: нейросети и оплата ---
# mock — заглушки; позже: fal. mock2 — второй фиктивный провайдер для проверки подключения.
AI_PROVIDER=mock
# mock — тестовая оплата на /mock-pay; позже: yookassa.
PAYMENT_PROVIDER=mock
# Включить заглушки (/mock-pay, mock-провайдеры) при NODE_ENV=production. Вне продакшена включены всегда.
ENABLE_MOCKS=false
# Имитация задержки заглушек, секунд: кадр (по ТЗ 5–15) и видео (20–60).
MOCK_IMAGE_DELAY_SEC=8
MOCK_VIDEO_DELAY_SEC=30
# Вероятность случайной ошибки заглушки, от 0 до 1 (1 — падает всегда, для проверки needs_help).
MOCK_FAILURE_RATE=0
# Ключи боевых сервисов — заполняются на следующем этапе.
FAL_KEY=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Очереди и режимы ---
# Сколько задач одновременно в очередях video и preview.
VIDEO_CONCURRENCY=5
PREVIEW_CONCURRENCY=10
# Начальное значение «Ручного одобрения» видео; дальше меняется переключателем в админке.
MANUAL_APPROVAL=true
# false — приём заказов закрыт, сайт показывает «Сервис временно недоступен».
ORDERS_ENABLED=true
